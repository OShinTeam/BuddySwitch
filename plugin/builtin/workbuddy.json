{
  "id": "workbuddy",
  "name": "WorkBuddy",
  "description": "WorkBuddy 的自定义模型配置。官方文档存在两种结构：根节点直接是数组，或 {\"models\": [...]}，这里按顺序兼容两者。",
  "vendor": "Tencent",
  "color": "#3B82F6",
  "version": "1.1.0",
  "order": 10,
  "enabled": true,
  "source": {
    "format": "json",
    "paths": {
      "windows": [
        "%USERPROFILE%\\.workbuddy\\models.json",
        "%APPDATA%\\WorkBuddy\\models.json",
        "%APPDATA%\\WorkBuddy CN\\models.json"
      ],
      "darwin": [
        "~/.workbuddy/models.json",
        "~/Library/Application Support/WorkBuddy/models.json"
      ],
      "linux": [
        "~/.workbuddy/models.json",
        "~/.config/WorkBuddy/models.json"
      ]
    }
  },
  "schema": {
    "container": ["", "models"],
    "fields": {
      "id": "id",
      "display_name": "name",
      "provider": "vendor",
      "base_url": "url",
      "api_key": "apiKey"
    },
    "capabilities": {
      "tool_call": "supportsToolCall",
      "images": "supportsImages",
      "reasoning": "supportsReasoning"
    },
    "sync_list": "availableModels"
  },
  "probe": {
    "type": "openai",
    "endpoint": "{{base_url}}",
    "ensure_path": "/chat/completions",
    "method": "POST",
    "headers": {
      "Authorization": "Bearer {{api_key}}"
    },
    "body": {
      "model": "{{id}}",
      "messages": [
        { "role": "user", "content": "ping" }
      ],
      "max_tokens": 1,
      "stream": false
    },
    "timeout_ms": 15000
  },
  "listing": {
    "endpoint": "{{base_url}}",
    "strip_suffix": "/chat/completions",
    "ensure_path": "/models",
    "method": "GET",
    "headers": {
      "Authorization": "Bearer {{api_key}}"
    },
    "timeout_ms": 20000,
    "array_path": "data",
    "id_field": "id",
    "name_field": "id",
    "note_field": "owned_by"
  }
}
